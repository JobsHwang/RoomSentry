# Copy to .env manually if desired. The application never prints secret values.
# Full reference for every setting (TOML key, default, env override):
# docs/configuration.md — this file is only a quick template.

# Storage: NAS is used only when this explicit path already exists and is writable.
BABY_MONITOR_LOCAL_ROOT=./data
BABY_MONITOR_NAS_ROOT=
BABY_MONITOR_PREFER_NAS=false
BABY_MONITOR_DATABASE=./data/events.sqlite3

# Retention: both settings must remain false until deletion is explicitly approved.
BABY_MONITOR_RETENTION_DAYS=14
BABY_MONITOR_RETENTION_SCAN_ENABLED=false
BABY_MONITOR_RETENTION_DELETE_ENABLED=false

# Camera adapter. Do not embed credentials here in a committed file.
BABY_MONITOR_CAMERA_ID=nursery_cam_01
BABY_MONITOR_CAMERA_KIND=file
BABY_MONITOR_CAMERA_SOURCE=

# Detector. A real YOLO run requires an existing local file; auto-download is blocked.
BABY_MONITOR_DETECTOR_BACKEND=mock
BABY_MONITOR_YOLO_MODEL_PATH=
BABY_MONITOR_YOLO_MANIFEST_PATH=
BABY_MONITOR_YOLO_DEVICE=0
BABY_MONITOR_YOLO_CONFIDENCE=0.35
BABY_MONITOR_SAMPLE_FPS=1.0

# Media windows and keyframes.
BABY_MONITOR_PRE_EVENT_SECONDS=5.0
BABY_MONITOR_POST_EVENT_SECONDS=7.0
BABY_MONITOR_KEYFRAME_COUNT=5

# MediaSource health freshness. This only assesses state; it does not restart services.
BABY_MONITOR_MEDIA_HEALTH_STALE_SECONDS=10
BABY_MONITOR_MEDIA_HEALTH_FUTURE_TOLERANCE_SECONDS=5

# Bounded low-cost candidate scanning. No VLM is loaded by this worker.
BABY_MONITOR_CANDIDATE_MAX_SEGMENTS_PER_RUN=32
BABY_MONITOR_CANDIDATE_IDLE_EXIT_SECONDS=30
BABY_MONITOR_CANDIDATE_MAX_RUNTIME_SECONDS=3600
BABY_MONITOR_CANDIDATE_POLL_SECONDS=1
BABY_MONITOR_CANDIDATE_MAX_EVENT_SPAN_SECONDS=30
BABY_MONITOR_CANDIDATE_MAX_PENDING_DETECTIONS=1000
BABY_MONITOR_CANDIDATE_DETECTOR_TIMEOUT_SECONDS=120

# Persistent analysis queue: bounded; no media deletion when full or failed.
BABY_MONITOR_ANALYSIS_QUEUE_MAX_PENDING=32
BABY_MONITOR_ANALYSIS_QUEUE_LEASE_SECONDS=300
BABY_MONITOR_ANALYSIS_QUEUE_RETRY_DELAY_SECONDS=30
BABY_MONITOR_ANALYSIS_QUEUE_MAX_ATTEMPTS=3

# Bounded sequential worker lifecycle. At least one stopping bound must be non-zero.
BABY_MONITOR_ANALYSIS_MAX_JOBS_PER_RUN=32
BABY_MONITOR_ANALYSIS_IDLE_EXIT_SECONDS=30
BABY_MONITOR_ANALYSIS_MAX_RUNTIME_SECONDS=3600
BABY_MONITOR_ANALYSIS_POLL_SECONDS=2

# Persistent archive queue: NAS outages leave jobs pending; source files are never deleted.
BABY_MONITOR_ARCHIVE_QUEUE_MAX_PENDING=64
BABY_MONITOR_ARCHIVE_QUEUE_LEASE_SECONDS=3600
BABY_MONITOR_ARCHIVE_QUEUE_RETRY_DELAY_SECONDS=300
BABY_MONITOR_ARCHIVE_QUEUE_MAX_ATTEMPTS=20

# Bounded sequential archive worker. The target root is still supplied as a private CLI path.
BABY_MONITOR_ARCHIVE_MAX_JOBS_PER_RUN=32
BABY_MONITOR_ARCHIVE_IDLE_EXIT_SECONDS=30
BABY_MONITOR_ARCHIVE_MAX_RUNTIME_SECONDS=3600
BABY_MONITOR_ARCHIVE_POLL_SECONDS=5

# Optional read-only NVIDIA guard. Enable in the game-machine private config.
BABY_MONITOR_ANALYSIS_GPU_GUARD_ENABLED=false
BABY_MONITOR_ANALYSIS_GPU_DEVICE=0
BABY_MONITOR_ANALYSIS_MIN_FREE_VRAM_MIB=6000
BABY_MONITOR_ANALYSIS_MAX_GPU_UTILIZATION_PERCENT=20

# Local VLM: one backend at a time. Command argv stays in TOML, not an env string.
BABY_MONITOR_LOCAL_VLM_BACKEND=mock
BABY_MONITOR_LOCAL_VLM_NAME=mock
BABY_MONITOR_LOCAL_VLM_REVISION=
BABY_MONITOR_LOCAL_VLM_TIMEOUT_SECONDS=180
BABY_MONITOR_LOCAL_CONFIDENCE_THRESHOLD=0.65
BABY_MONITOR_LOCAL_VLM_GPU_DEVICE=0

# Review escalation. Frequency raises review tier only; it never rewrites facts or risk.
BABY_MONITOR_SIGNAL_FREQUENCY_WINDOW_SECONDS=600
BABY_MONITOR_SIGNAL_FREQUENCY_SECONDARY_THRESHOLD=3

# Optional second local reviewer. Heavyweight command argv stays in private TOML.
BABY_MONITOR_SECONDARY_VLM_ENABLED=false
BABY_MONITOR_SECONDARY_VLM_BACKEND=mock
BABY_MONITOR_SECONDARY_VLM_NAME=secondary_mock
BABY_MONITOR_SECONDARY_VLM_REVISION=
BABY_MONITOR_SECONDARY_VLM_TIMEOUT_SECONDS=180
BABY_MONITOR_SECONDARY_VLM_GPU_DEVICE=0

# Remote fallback is disabled twice: feature flag and upload consent.
BABY_MONITOR_REMOTE_ENABLED=false
BABY_MONITOR_REMOTE_UPLOAD_CONSENT=false
BABY_MONITOR_REMOTE_BASE_URL=
BABY_MONITOR_REMOTE_MODEL=
BABY_MONITOR_REMOTE_API_KEY_ENV=BABY_MONITOR_REMOTE_API_KEY
BABY_MONITOR_REMOTE_MAX_FRAMES=3
BABY_MONITOR_REMOTE_TIMEOUT_SECONDS=60
BABY_MONITOR_REMOTE_MAX_UPLOAD_BYTES=5242880
BABY_MONITOR_REMOTE_MAX_RESPONSE_BYTES=262144
BABY_MONITOR_REMOTE_MAX_REQUESTS_PER_DAY=20
BABY_MONITOR_REMOTE_MIN_INTERVAL_SECONDS=60

# Never commit the actual key.
BABY_MONITOR_REMOTE_API_KEY=

# Local stdout/file notification fixtures are disabled by default.
# No HTTP/webhook provider is implemented in the core notification layer.
BABY_MONITOR_NOTIFICATION_ENABLED=false
BABY_MONITOR_NOTIFICATION_MAX_PENDING=64
BABY_MONITOR_NOTIFICATION_MAX_PENDING_AGE_SECONDS=3600
BABY_MONITOR_NOTIFICATION_LEASE_SECONDS=300
BABY_MONITOR_NOTIFICATION_RETRY_DELAY_SECONDS=30
BABY_MONITOR_NOTIFICATION_MAX_ATTEMPTS=5
