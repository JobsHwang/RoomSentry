{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baby Monitor AdmittedDetectorScan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source_admission_sha256",
    "labels",
    "confidence_threshold",
    "requested_sample_fps",
    "result"
  ],
  "properties": {
    "version": {"const": 1},
    "source_admission_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/label"}
    },
    "confidence_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requested_sample_fps": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 10
    },
    "result": {"$ref": "#/$defs/result"}
  },
  "$defs": {
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp_seconds",
        "label",
        "confidence",
        "bbox_xyxy"
      ],
      "properties": {
        "timestamp_seconds": {"type": "number", "minimum": 0},
        "label": {"$ref": "#/$defs/label"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "bbox_xyxy": {"$ref": "#/$defs/bbox"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "camera_id",
        "detector_adapter",
        "model_id",
        "model_revision",
        "model_sha256",
        "detections",
        "subject_identity_inference",
        "paths_disclosed"
      ],
      "properties": {
        "version": {"const": 1},
        "camera_id": {"$ref": "#/$defs/safeId"},
        "detector_adapter": {"$ref": "#/$defs/safeId"},
        "model_id": {"$ref": "#/$defs/safeId"},
        "model_revision": {"$ref": "#/$defs/safeId"},
        "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "detections": {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/detection"}
        },
        "subject_identity_inference": {"const": false},
        "paths_disclosed": {"const": false}
      }
    }
  }
}
