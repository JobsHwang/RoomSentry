{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baby Monitor Detector Scan Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "camera_id",
    "detector_adapter",
    "model_id",
    "model_revision",
    "model_sha256",
    "detections",
    "sampling",
    "subject_identity_inference",
    "paths_disclosed"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "camera_id": {
      "$ref": "#/$defs/safeId"
    },
    "detector_adapter": {
      "$ref": "#/$defs/safeId"
    },
    "model_id": {
      "$ref": "#/$defs/safeId"
    },
    "model_revision": {
      "$ref": "#/$defs/safeId"
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "detections": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/detection"
      }
    },
    "sampling": {
      "$ref": "#/$defs/sampling"
    },
    "subject_identity_inference": {
      "const": false
    },
    "paths_disclosed": {
      "const": false
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp_seconds",
        "label",
        "confidence",
        "bbox_xyxy"
      ],
      "properties": {
        "timestamp_seconds": {
          "type": "number",
          "minimum": 0
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bbox_xyxy": {
          "$ref": "#/$defs/bbox"
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decoded_frame_index",
        "timestamp_seconds",
        "timestamp_source",
        "detection_start",
        "detection_count"
      ],
      "properties": {
        "decoded_frame_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999999
        },
        "timestamp_seconds": {
          "type": "number",
          "minimum": 0
        },
        "timestamp_source": {
          "enum": [
            "container_pts",
            "nominal_fps"
          ]
        },
        "detection_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "detection_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_fps",
        "native_fps_source",
        "requested_sample_fps",
        "frame_step",
        "decoded_frame_count",
        "samples",
        "timestamp_fallback_frame_count",
        "container_pts_regression_count",
        "max_adjacent_container_pts_gap_seconds",
        "end_reason",
        "source_exhaustion_verified"
      ],
      "properties": {
        "native_fps": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1000
        },
        "native_fps_source": {
          "enum": [
            "reported",
            "fallback_25"
          ]
        },
        "requested_sample_fps": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 10
        },
        "frame_step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "decoded_frame_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/sample"
          }
        },
        "timestamp_fallback_frame_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "container_pts_regression_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999999
        },
        "max_adjacent_container_pts_gap_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "end_reason": {
          "const": "read_returned_false"
        },
        "source_exhaustion_verified": {
          "const": false
        }
      }
    }
  }
}
