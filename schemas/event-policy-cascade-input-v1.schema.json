{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baby Monitor Event Policy Cascade Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": {"const": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "event_id",
        "camera_id",
        "occurred_at",
        "event_type",
        "result_needs_remote_review",
        "decision"
      ],
      "properties": {
        "version": {"const": 1},
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
        },
        "camera_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
        },
        "occurred_at": {"type": "string", "format": "date-time"},
        "event_type": {
          "enum": [
            "sleeping",
            "awake",
            "crying",
            "movement",
            "adult_interaction",
            "possible_risk",
            "unknown"
          ]
        },
        "result_needs_remote_review": {"type": "boolean"},
        "decision": {"$ref": "decision-record-v1.schema.json"}
      }
    }
  }
}
