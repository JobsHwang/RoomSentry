{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baby Monitor VLM Evaluation Case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "case_id", "frames", "question", "expected"],
  "properties": {
    "version": {"const": 1},
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,80}$"
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frame_id", "path", "sha256"],
        "properties": {
          "frame_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,80}$"
          },
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "question": {"type": "string", "minLength": 1, "maxLength": 4000},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "risk_level",
        "allowed_subjects",
        "allowed_observations",
        "allowed_inferences"
      ],
      "properties": {
        "event_type": {
          "type": "string",
          "enum": [
            "sleeping",
            "awake",
            "crying",
            "movement",
            "adult_interaction",
            "possible_risk",
            "unknown"
          ]
        },
        "risk_level": {
          "type": "string",
          "enum": ["none", "low", "medium", "high"]
        },
        "allowed_subjects": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 5,
          "items": {
            "type": "string",
            "enum": ["baby", "adult", "person", "pet", "unknown"]
          }
        },
        "allowed_observations": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "allowed_inferences": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  }
}
