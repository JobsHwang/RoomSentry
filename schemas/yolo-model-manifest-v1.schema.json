{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baby Monitor YOLO Model Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "backend",
    "model_id",
    "revision",
    "filename",
    "sha256",
    "size_bytes",
    "source_url",
    "license_spdx",
    "license_url",
    "labels",
    "subject_identity_inference"
  ],
  "properties": {
    "version": {"const": 1},
    "backend": {"const": "ultralytics_yolo"},
    "model_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "revision": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "filename": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,199}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967296
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^?#]+$",
      "maxLength": 2048
    },
    "license_spdx": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,79}$"
    },
    "license_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^?#]+$",
      "maxLength": 2048
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[^\\u0000\\r\\n]+$"
      }
    },
    "subject_identity_inference": {"const": false}
  }
}
