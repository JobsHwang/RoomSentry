{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baby Monitor DetectorBoxQualityReport v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "ground_truth_batch_sha256",
    "ground_truth_review_sha256",
    "ground_truth_admission_sha256",
    "media_admission_sha256",
    "detector_scan_sha256",
    "camera_id",
    "detector_adapter",
    "model_id",
    "model_revision",
    "model_sha256",
    "label",
    "confidence_threshold",
    "requested_sample_fps",
    "source_fps",
    "effective_sample_fps",
    "sample_step_frames",
    "source_frame_count",
    "annotation_frame_count",
    "annotation_frame_offset",
    "ignored_trailing_source_frame_count",
    "ignored_trailing_detector_box_count",
    "iou_threshold",
    "evaluated_frame_count",
    "evaluated_frames_with_ground_truth",
    "ground_truth_box_count",
    "detector_box_count",
    "matched_box_count",
    "missed_ground_truth_box_count",
    "false_positive_box_count",
    "precision",
    "recall",
    "f1",
    "mean_matched_iou",
    "frames_without_detector_boxes",
    "frames_with_missed_boxes",
    "frames_with_false_positive_boxes",
    "ground_truth_subject_count",
    "subjects_with_missed_boxes",
    "longest_consecutive_subject_miss_samples",
    "longest_consecutive_subject_miss_seconds",
    "ground_truth_provenance",
    "frame_alignment_provenance",
    "frame_alignment_confirmed",
    "detection_accuracy_evaluated",
    "missed_detections_evaluated",
    "subject_identity_inference",
    "age_role_inference",
    "source_media_included",
    "paths_disclosed",
    "report_sha256"
  ],
  "properties": {
    "version": {"const": 1},
    "ground_truth_batch_sha256": {"$ref": "#/$defs/sha256"},
    "ground_truth_review_sha256": {"$ref": "#/$defs/sha256"},
    "ground_truth_admission_sha256": {"$ref": "#/$defs/sha256"},
    "media_admission_sha256": {"$ref": "#/$defs/sha256"},
    "detector_scan_sha256": {"$ref": "#/$defs/sha256"},
    "camera_id": {"$ref": "#/$defs/id"},
    "detector_adapter": {"$ref": "#/$defs/id"},
    "model_id": {"$ref": "#/$defs/id"},
    "model_revision": {"$ref": "#/$defs/id"},
    "model_sha256": {"$ref": "#/$defs/sha256"},
    "label": {"const": "person"},
    "confidence_threshold": {"$ref": "#/$defs/ratio"},
    "requested_sample_fps": {"type": "number", "minimum": 0.01, "maximum": 10},
    "source_fps": {"type": "number", "minimum": 0.01, "maximum": 240},
    "effective_sample_fps": {"type": "number", "minimum": 0.01, "maximum": 240},
    "sample_step_frames": {"$ref": "#/$defs/positiveCount"},
    "source_frame_count": {"$ref": "#/$defs/positiveCount"},
    "annotation_frame_count": {"$ref": "#/$defs/positiveCount"},
    "annotation_frame_offset": {"$ref": "#/$defs/count"},
    "ignored_trailing_source_frame_count": {"$ref": "#/$defs/count"},
    "ignored_trailing_detector_box_count": {"$ref": "#/$defs/count"},
    "iou_threshold": {"type": "number", "minimum": 0.01, "maximum": 1},
    "evaluated_frame_count": {"$ref": "#/$defs/count"},
    "evaluated_frames_with_ground_truth": {"$ref": "#/$defs/count"},
    "ground_truth_box_count": {"$ref": "#/$defs/count"},
    "detector_box_count": {"$ref": "#/$defs/count"},
    "matched_box_count": {"$ref": "#/$defs/count"},
    "missed_ground_truth_box_count": {"$ref": "#/$defs/count"},
    "false_positive_box_count": {"$ref": "#/$defs/count"},
    "precision": {"$ref": "#/$defs/optionalRatio"},
    "recall": {"$ref": "#/$defs/optionalRatio"},
    "f1": {"$ref": "#/$defs/optionalRatio"},
    "mean_matched_iou": {"$ref": "#/$defs/optionalRatio"},
    "frames_without_detector_boxes": {"$ref": "#/$defs/count"},
    "frames_with_missed_boxes": {"$ref": "#/$defs/count"},
    "frames_with_false_positive_boxes": {"$ref": "#/$defs/count"},
    "ground_truth_subject_count": {"$ref": "#/$defs/count"},
    "subjects_with_missed_boxes": {"$ref": "#/$defs/count"},
    "longest_consecutive_subject_miss_samples": {"$ref": "#/$defs/count"},
    "longest_consecutive_subject_miss_seconds": {"type": "number", "minimum": 0, "maximum": 86400},
    "ground_truth_provenance": {"const": "admitted_publisher_human"},
    "frame_alignment_provenance": {"const": "explicit_local_ffprobe_and_visual_spot_check"},
    "frame_alignment_confirmed": {"const": true},
    "detection_accuracy_evaluated": {"const": true},
    "missed_detections_evaluated": {"const": true},
    "subject_identity_inference": {"const": false},
    "age_role_inference": {"const": false},
    "source_media_included": {"const": false},
    "paths_disclosed": {"const": false},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "positiveCount": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "optionalRatio": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/ratio"}
      ]
    }
  }
}
