{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/baby-monitor/identity-assessment-v1.schema.json",
  "title": "IdentityAssessment v1",
  "$comment": "The canonical IdentityAssessment parser additionally enforces one-to-one ordered observation/inference pairing, matching face/frame references, threshold equality with the enclosing assessment, and agreement between rejected observations and quality_rejected inferences. Those cross-array and parent/child comparisons are not expressible in portable JSON Schema 2020-12.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "assessment_id",
    "event_id",
    "camera_id",
    "observations",
    "inferences",
    "model_fingerprint",
    "embedding_dimension",
    "matcher_revision",
    "threshold_revision",
    "match_threshold",
    "runner_up_margin_threshold",
    "cross_camera_linking",
    "tracker_identity_propagation",
    "paths_disclosed"
  ],
  "properties": {
    "version": {"const": 1},
    "assessment_id": {"$ref": "#/$defs/identifier"},
    "event_id": {"$ref": "#/$defs/identifier"},
    "camera_id": {"$ref": "#/$defs/identifier"},
    "observations": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/face_observation"}
    },
    "inferences": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/identity_inference"}
    },
    "model_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "embedding_dimension": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "matcher_revision": {"$ref": "#/$defs/identifier"},
    "threshold_revision": {"$ref": "#/$defs/identifier"},
    "match_threshold": {"type": "number", "minimum": -1, "maximum": 1},
    "runner_up_margin_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "cross_camera_linking": {"const": false},
    "tracker_identity_propagation": {"const": false},
    "paths_disclosed": {"const": false}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "bbox": {
      "$comment": "JSON Schema cannot compare array items. The canonical parser additionally requires x_min < x_max and y_min < y_max, so zero/negative-area boxes fail closed there.",
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "face_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "face_id",
        "frame_ref",
        "bbox_xyxy",
        "detector_confidence",
        "quality_state",
        "rejection_codes"
      ],
      "properties": {
        "face_id": {"$ref": "#/$defs/identifier"},
        "frame_ref": {"$ref": "#/$defs/identifier"},
        "bbox_xyxy": {"$ref": "#/$defs/bbox"},
        "detector_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "quality_state": {"enum": ["accepted", "rejected"]},
        "rejection_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["quality_state"],
            "properties": {"quality_state": {"const": "accepted"}}
          },
          "then": {
            "properties": {"rejection_codes": {"maxItems": 0}}
          }
        },
        {
          "if": {
            "required": ["quality_state"],
            "properties": {"quality_state": {"const": "rejected"}}
          },
          "then": {
            "properties": {"rejection_codes": {"minItems": 1}}
          }
        }
      ]
    },
    "identity_inference": {
      "$comment": "JSON Schema cannot compare sibling numeric values. The canonical parser additionally enforces match_score >= decision_threshold for matched/ambiguous decisions, runner_up_margin >= its threshold for matched decisions when present, runner_up_margin < its threshold for ambiguous decisions, and match_score < its threshold for below_match_threshold.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "face_id",
        "outcome",
        "profile_id",
        "declared_kind",
        "match_score",
        "decision_threshold",
        "runner_up_margin",
        "runner_up_margin_threshold",
        "reason_code",
        "support_frame_refs"
      ],
      "properties": {
        "face_id": {"$ref": "#/$defs/identifier"},
        "outcome": {
          "enum": ["matched", "unknown", "ambiguous", "quality_rejected"]
        },
        "profile_id": {
          "oneOf": [
            {"$ref": "#/$defs/identifier"},
            {"type": "null"}
          ]
        },
        "declared_kind": {"enum": ["baby", "adult", "person", "unknown"]},
        "match_score": {
          "oneOf": [
            {"type": "number", "minimum": -1, "maximum": 1},
            {"type": "null"}
          ]
        },
        "decision_threshold": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "runner_up_margin": {
          "oneOf": [
            {"type": "number", "minimum": 0, "maximum": 2},
            {"type": "null"}
          ]
        },
        "runner_up_margin_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "reason_code": {
          "enum": [
            "threshold_and_margin_passed",
            "below_match_threshold",
            "insufficient_runner_up_margin",
            "quality_rejected",
            "single_profile_uncalibrated",
            "no_templates",
            "missing_embedding",
            "model_fingerprint_mismatch",
            "embedding_dimension_mismatch",
            "nonfinite_embedding",
            "invalid_embedding_norm",
            "invalid_template_set"
          ]
        },
        "support_frame_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["outcome"],
            "properties": {"outcome": {"const": "matched"}}
          },
          "then": {
            "properties": {
              "profile_id": {"$ref": "#/$defs/identifier"},
              "declared_kind": {"enum": ["baby", "adult", "person"]},
              "match_score": {"type": "number", "minimum": -1, "maximum": 1},
              "reason_code": {"const": "threshold_and_margin_passed"}
            }
          }
        },
        {
          "if": {
            "required": ["outcome"],
            "properties": {"outcome": {"const": "ambiguous"}}
          },
          "then": {
            "properties": {
              "profile_id": {"type": "null"},
              "declared_kind": {"const": "unknown"},
              "match_score": {"type": "number", "minimum": -1, "maximum": 1},
              "runner_up_margin": {"type": "number", "minimum": 0, "maximum": 2},
              "reason_code": {"const": "insufficient_runner_up_margin"}
            }
          }
        },
        {
          "if": {
            "required": ["outcome"],
            "properties": {"outcome": {"const": "quality_rejected"}}
          },
          "then": {
            "properties": {
              "profile_id": {"type": "null"},
              "declared_kind": {"const": "unknown"},
              "match_score": {"type": "null"},
              "runner_up_margin": {"type": "null"},
              "reason_code": {"const": "quality_rejected"}
            }
          }
        },
        {
          "if": {
            "required": ["outcome"],
            "properties": {"outcome": {"const": "unknown"}}
          },
          "then": {
            "properties": {
              "profile_id": {"type": "null"},
              "declared_kind": {"const": "unknown"},
              "reason_code": {
                "enum": [
                  "below_match_threshold",
                  "single_profile_uncalibrated",
                  "no_templates",
                  "missing_embedding",
                  "model_fingerprint_mismatch",
                  "embedding_dimension_mismatch",
                  "nonfinite_embedding",
                  "invalid_embedding_norm",
                  "invalid_template_set"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "required": ["reason_code"],
                  "properties": {"reason_code": {"const": "below_match_threshold"}}
                },
                "then": {
                  "properties": {
                    "match_score": {"type": "number", "minimum": -1, "maximum": 1}
                  }
                },
                "else": {
                  "properties": {
                    "match_score": {"type": "null"},
                    "runner_up_margin": {"type": "null"}
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
