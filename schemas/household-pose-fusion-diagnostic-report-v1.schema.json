{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/baby-monitor/household-pose-fusion-diagnostic-report-v1.schema.json",
  "title": "Baby Monitor HouseholdPoseFusionDiagnosticReport v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_sha256",
    "media_admission_sha256s",
    "detector_scan_sha256s",
    "pose_scan_sha256s",
    "camera_ids",
    "profile",
    "detector_adapter",
    "detector_model_id",
    "detector_model_revision",
    "detector_model_sha256",
    "detector_source_confidence_threshold",
    "detector_requested_sample_fps",
    "pose_adapter",
    "pose_model_id",
    "pose_model_revision",
    "pose_model_sha256",
    "pose_source_confidence_threshold",
    "pose_requested_sample_fps",
    "pose_requested_max_frames",
    "pose_image_size",
    "pose_rotation_degrees",
    "bin_seconds",
    "sampling_strategy",
    "reviewed_frame_count",
    "evaluated_bin_count",
    "positive_bin_count",
    "negative_bin_count",
    "unknown_bin_count",
    "conflicting_bin_count",
    "clear_positive_bin_count",
    "partial_positive_bin_count",
    "metrics",
    "version",
    "label",
    "ground_truth_provenance",
    "fusion_operator",
    "temporal_aggregation_strategy",
    "prediction_anchor",
    "hold_window_semantics",
    "conflict_resolution_strategy",
    "conflicting_bins_excluded",
    "diagnostic_only",
    "shadow_only",
    "derived_without_model_rerun",
    "model_generated_labels",
    "human_verified",
    "ground_truth",
    "official_accuracy_claim",
    "profile_selected_on_evaluation_data",
    "frame_level_alignment_evaluated",
    "candidate_trigger_coverage_evaluated",
    "box_localization_accuracy_evaluated",
    "danger_recognition_accuracy_evaluated",
    "risk_accuracy_evaluated",
    "winner_selected",
    "deployment_approved",
    "household_configuration_changed",
    "dataset_specific_only",
    "subject_identity_inference",
    "posture_classification",
    "source_media_included",
    "paths_disclosed",
    "report_sha256"
  ],
  "properties": {
    "review_sha256": {"$ref": "#/$defs/sha256"},
    "media_admission_sha256s": {"$ref": "#/$defs/sourceHashes"},
    "detector_scan_sha256s": {"$ref": "#/$defs/sourceHashes"},
    "pose_scan_sha256s": {"$ref": "#/$defs/sourceHashes"},
    "camera_ids": {"$ref": "#/$defs/cameraIds"},
    "profile": {"$ref": "household-pose-fusion-profile-v1.schema.json"},
    "detector_adapter": {"$ref": "#/$defs/id"},
    "detector_model_id": {"$ref": "#/$defs/id"},
    "detector_model_revision": {"$ref": "#/$defs/id"},
    "detector_model_sha256": {"$ref": "#/$defs/sha256"},
    "detector_source_confidence_threshold": {"$ref": "#/$defs/ratio"},
    "detector_requested_sample_fps": {"$ref": "#/$defs/sampleFps"},
    "pose_adapter": {"$ref": "#/$defs/id"},
    "pose_model_id": {"$ref": "#/$defs/id"},
    "pose_model_revision": {"$ref": "#/$defs/id"},
    "pose_model_sha256": {"$ref": "#/$defs/sha256"},
    "pose_source_confidence_threshold": {"$ref": "#/$defs/ratio"},
    "pose_requested_sample_fps": {"$ref": "#/$defs/sampleFps"},
    "pose_requested_max_frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "pose_image_size": {
      "type": "integer",
      "minimum": 320,
      "maximum": 1280,
      "multipleOf": 32
    },
    "pose_rotation_degrees": {"enum": [0, 90, 180, 270]},
    "bin_seconds": {"type": "number", "minimum": 0.1, "maximum": 60},
    "sampling_strategy": {
      "enum": [
        "candidate_disagreement_and_control",
        "candidate_targeted",
        "uniform_grid"
      ]
    },
    "reviewed_frame_count": {"$ref": "#/$defs/positiveCount"},
    "evaluated_bin_count": {"$ref": "#/$defs/positiveCount"},
    "positive_bin_count": {"$ref": "#/$defs/count"},
    "negative_bin_count": {"$ref": "#/$defs/count"},
    "unknown_bin_count": {"$ref": "#/$defs/count"},
    "conflicting_bin_count": {"$ref": "#/$defs/count"},
    "clear_positive_bin_count": {"$ref": "#/$defs/count"},
    "partial_positive_bin_count": {"$ref": "#/$defs/count"},
    "metrics": {"$ref": "#/$defs/metrics"},
    "version": {"const": 1},
    "label": {"const": "person"},
    "ground_truth_provenance": {"const": "model_generated_visual_review"},
    "fusion_operator": {"const": "detector_or_gated_pose"},
    "temporal_aggregation_strategy": {"const": "independent_causal_signal_holds"},
    "prediction_anchor": {"const": "bin_end"},
    "hold_window_semantics": {"const": "current_bin_plus_prior_seconds"},
    "conflict_resolution_strategy": {"const": "exclude_present_absent_conflicts"},
    "conflicting_bins_excluded": {"const": true},
    "diagnostic_only": {"const": true},
    "shadow_only": {"const": true},
    "derived_without_model_rerun": {"const": true},
    "model_generated_labels": {"const": true},
    "human_verified": {"const": false},
    "ground_truth": {"const": false},
    "official_accuracy_claim": {"const": false},
    "profile_selected_on_evaluation_data": {"const": true},
    "frame_level_alignment_evaluated": {"const": false},
    "candidate_trigger_coverage_evaluated": {"const": false},
    "box_localization_accuracy_evaluated": {"const": false},
    "danger_recognition_accuracy_evaluated": {"const": false},
    "risk_accuracy_evaluated": {"const": false},
    "winner_selected": {"const": false},
    "deployment_approved": {"const": false},
    "household_configuration_changed": {"const": false},
    "dataset_specific_only": {"const": true},
    "subject_identity_inference": {"const": false},
    "posture_classification": {"const": false},
    "source_media_included": {"const": false},
    "paths_disclosed": {"const": false},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceHashes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "cameraIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "positiveCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "optionalRatio": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/ratio"}
      ]
    },
    "sampleFps": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 10
    },
    "cameraPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera_id",
        "evaluated_bin_count",
        "positive_bin_count",
        "negative_bin_count",
        "clear_positive_count",
        "partial_positive_count",
        "true_positive",
        "false_positive",
        "false_negative",
        "true_negative",
        "precision",
        "recall",
        "f1",
        "specificity",
        "false_positive_rate",
        "clear_detected_count",
        "clear_visibility_recall",
        "partial_detected_count",
        "partial_visibility_recall"
      ],
      "properties": {
        "camera_id": {"$ref": "#/$defs/id"},
        "evaluated_bin_count": {"$ref": "#/$defs/count"},
        "positive_bin_count": {"$ref": "#/$defs/count"},
        "negative_bin_count": {"$ref": "#/$defs/count"},
        "clear_positive_count": {"$ref": "#/$defs/count"},
        "partial_positive_count": {"$ref": "#/$defs/count"},
        "true_positive": {"$ref": "#/$defs/count"},
        "false_positive": {"$ref": "#/$defs/count"},
        "false_negative": {"$ref": "#/$defs/count"},
        "true_negative": {"$ref": "#/$defs/count"},
        "precision": {"$ref": "#/$defs/optionalRatio"},
        "recall": {"$ref": "#/$defs/optionalRatio"},
        "f1": {"$ref": "#/$defs/optionalRatio"},
        "specificity": {"$ref": "#/$defs/optionalRatio"},
        "false_positive_rate": {"$ref": "#/$defs/optionalRatio"},
        "clear_detected_count": {"$ref": "#/$defs/count"},
        "clear_visibility_recall": {"$ref": "#/$defs/optionalRatio"},
        "partial_detected_count": {"$ref": "#/$defs/count"},
        "partial_visibility_recall": {"$ref": "#/$defs/optionalRatio"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "true_positive",
        "false_positive",
        "false_negative",
        "true_negative",
        "precision",
        "recall",
        "f1",
        "specificity",
        "false_positive_rate",
        "clear_positive_count",
        "clear_detected_count",
        "clear_visibility_recall",
        "partial_positive_count",
        "partial_detected_count",
        "partial_visibility_recall",
        "maximum_negative_camera_false_positive_rate",
        "camera_points"
      ],
      "properties": {
        "true_positive": {"$ref": "#/$defs/count"},
        "false_positive": {"$ref": "#/$defs/count"},
        "false_negative": {"$ref": "#/$defs/count"},
        "true_negative": {"$ref": "#/$defs/count"},
        "precision": {"$ref": "#/$defs/optionalRatio"},
        "recall": {"$ref": "#/$defs/optionalRatio"},
        "f1": {"$ref": "#/$defs/optionalRatio"},
        "specificity": {"$ref": "#/$defs/optionalRatio"},
        "false_positive_rate": {"$ref": "#/$defs/optionalRatio"},
        "clear_positive_count": {"$ref": "#/$defs/count"},
        "clear_detected_count": {"$ref": "#/$defs/count"},
        "clear_visibility_recall": {"$ref": "#/$defs/optionalRatio"},
        "partial_positive_count": {"$ref": "#/$defs/count"},
        "partial_detected_count": {"$ref": "#/$defs/count"},
        "partial_visibility_recall": {"$ref": "#/$defs/optionalRatio"},
        "maximum_negative_camera_false_positive_rate": {
          "$ref": "#/$defs/optionalRatio"
        },
        "camera_points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/cameraPoint"}
        }
      }
    }
  }
}
