{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roomsentry.example/schemas/household-human-presence-audit-v1.schema.json",
  "title": "HouseholdHumanPresenceAudit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_id",
    "created_at_utc",
    "completed_at_utc",
    "source_batch_id",
    "source_selection_manifest_sha256",
    "source_profile_sha256",
    "audit_manifest_sha256",
    "result_file_sha256",
    "bin_seconds",
    "camera_count",
    "frames_per_camera",
    "sampling_source",
    "within_camera_strategy",
    "presentation_order",
    "items",
    "version",
    "audit_type",
    "review_scope",
    "human_reviewer_count",
    "human_review_completed",
    "human_verified",
    "labels_created_without_model_outputs",
    "blind_ui_operator_attested",
    "blindness_cryptographically_proven",
    "single_human_reference",
    "model_generated_labels",
    "ground_truth",
    "independent_human_ground_truth",
    "temporal_episode_ground_truth",
    "official_accuracy_claim",
    "selected_stills_only",
    "clips_included",
    "audio_included",
    "identity_inference",
    "biometric_processing",
    "training_allowed",
    "redistribution_allowed",
    "deployment_change_authorized",
    "deployment_approved",
    "source_media_included",
    "paths_disclosed",
    "audit_sha256"
  ],
  "properties": {
    "audit_id": { "$ref": "#/$defs/safeId" },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "completed_at_utc": { "type": "string", "format": "date-time" },
    "source_batch_id": { "$ref": "#/$defs/safeId" },
    "source_selection_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "source_profile_sha256": { "$ref": "#/$defs/sha256" },
    "audit_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "result_file_sha256": { "$ref": "#/$defs/sha256" },
    "bin_seconds": { "type": "number", "minimum": 0.1, "maximum": 60 },
    "camera_count": { "type": "integer", "minimum": 1, "maximum": 32 },
    "frames_per_camera": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "sampling_source": { "const": "uniform_holdout_only" },
    "within_camera_strategy": { "const": "evenly_spaced_order_statistics" },
    "presentation_order": { "const": "deterministic_blinded_shuffle" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/item" }
    },
    "version": { "const": 1 },
    "audit_type": { "const": "independent_human_frame_presence_audit" },
    "review_scope": { "const": "visible_person_presence_only" },
    "human_reviewer_count": { "const": 1 },
    "human_review_completed": { "const": true },
    "human_verified": { "const": true },
    "labels_created_without_model_outputs": { "const": true },
    "blind_ui_operator_attested": { "const": true },
    "blindness_cryptographically_proven": { "const": false },
    "single_human_reference": { "const": true },
    "model_generated_labels": { "const": false },
    "ground_truth": { "const": false },
    "independent_human_ground_truth": { "const": false },
    "temporal_episode_ground_truth": { "const": false },
    "official_accuracy_claim": { "const": false },
    "selected_stills_only": { "const": true },
    "clips_included": { "const": false },
    "audio_included": { "const": false },
    "identity_inference": { "const": false },
    "biometric_processing": { "const": false },
    "training_allowed": { "const": false },
    "redistribution_allowed": { "const": false },
    "deployment_change_authorized": { "const": false },
    "deployment_approved": { "const": false },
    "source_media_included": { "const": false },
    "paths_disclosed": { "const": false },
    "audit_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_item_id",
        "source_review_id",
        "camera_id",
        "media_admission_sha256",
        "bin_index",
        "timestamp_seconds",
        "source_frame_sha256",
        "visible_person"
      ],
      "properties": {
        "review_item_id": { "$ref": "#/$defs/safeId" },
        "source_review_id": { "$ref": "#/$defs/safeId" },
        "camera_id": { "$ref": "#/$defs/safeId" },
        "media_admission_sha256": { "$ref": "#/$defs/sha256" },
        "bin_index": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "timestamp_seconds": { "type": "number", "minimum": 0, "maximum": 86400 },
        "source_frame_sha256": { "$ref": "#/$defs/sha256" },
        "visible_person": { "enum": ["absent", "present", "unknown"] }
      }
    }
  }
}
