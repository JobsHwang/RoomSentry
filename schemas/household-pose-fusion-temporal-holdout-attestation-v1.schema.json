{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/baby-monitor/household-pose-fusion-temporal-holdout-attestation-v1.schema.json",
  "title": "Baby Monitor HouseholdPoseFusionTemporalHoldoutAttestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selection_batch",
    "holdout_report",
    "version",
    "attestation_type",
    "temporal_holdout",
    "selection_batch_used_for_profile_selection",
    "profile_frozen_before_holdout_capture",
    "profile_selected_on_holdout",
    "selection_and_holdout_reports_distinct",
    "selection_and_holdout_reviews_distinct",
    "media_sets_disjoint",
    "detector_scan_sets_disjoint",
    "pose_scan_sets_disjoint",
    "capture_order_operator_confirmed",
    "capture_order_cryptographically_proven",
    "review_model_independence_established",
    "attestation_derived_without_model_rerun",
    "model_generated_labels",
    "human_verified",
    "ground_truth",
    "independent_human_ground_truth",
    "official_accuracy_claim",
    "deployment_approved",
    "household_configuration_changed",
    "dataset_specific_only",
    "source_media_included",
    "paths_disclosed",
    "attestation_sha256"
  ],
  "properties": {
    "selection_batch": {
      "$ref": "household-pose-fusion-batch-diagnostic-report-v1.schema.json"
    },
    "holdout_report": {
      "$ref": "household-pose-fusion-diagnostic-report-v1.schema.json"
    },
    "version": {"const": 1},
    "attestation_type": {"const": "frozen_profile_temporal_holdout"},
    "temporal_holdout": {"const": true},
    "selection_batch_used_for_profile_selection": {"const": true},
    "profile_frozen_before_holdout_capture": {"const": true},
    "profile_selected_on_holdout": {"const": false},
    "selection_and_holdout_reports_distinct": {"const": true},
    "selection_and_holdout_reviews_distinct": {"const": true},
    "media_sets_disjoint": {"const": true},
    "detector_scan_sets_disjoint": {"const": true},
    "pose_scan_sets_disjoint": {"const": true},
    "capture_order_operator_confirmed": {"const": true},
    "capture_order_cryptographically_proven": {"const": false},
    "review_model_independence_established": {"const": false},
    "attestation_derived_without_model_rerun": {"const": true},
    "model_generated_labels": {"const": true},
    "human_verified": {"const": false},
    "ground_truth": {"const": false},
    "independent_human_ground_truth": {"const": false},
    "official_accuracy_claim": {"const": false},
    "deployment_approved": {"const": false},
    "household_configuration_changed": {"const": false},
    "dataset_specific_only": {"const": true},
    "source_media_included": {"const": false},
    "paths_disclosed": {"const": false},
    "attestation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
