{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baby Monitor DetectionFrameBatch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "camera_id", "detector_adapter", "frames"],
  "properties": {
    "version": {"const": 1},
    "camera_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
    "detector_adapter": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,80}$"
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/frame"}
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detection_id", "label", "confidence", "bbox_xyxy"],
      "properties": {
        "detection_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,80}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "bbox_xyxy": {"$ref": "#/$defs/bbox"}
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "occurred_at", "detections"],
      "properties": {
        "frame_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "detections": {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/detection"}
        }
      }
    }
  }
}
