{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baby Monitor IoUTrackerConfig v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "iou_threshold",
    "max_track_age_seconds",
    "max_active_tracks",
    "max_processed_frames",
    "max_pending_observations"
  ],
  "properties": {
    "version": {"const": 1},
    "iou_threshold": {"type": "number", "minimum": 0.01, "maximum": 1},
    "max_track_age_seconds": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 300
    },
    "max_active_tracks": {"type": "integer", "minimum": 1, "maximum": 10000},
    "max_processed_frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "max_pending_observations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  }
}
