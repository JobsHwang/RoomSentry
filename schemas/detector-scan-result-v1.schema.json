{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baby Monitor Detector Scan Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "camera_id",
    "detector_adapter",
    "model_id",
    "model_revision",
    "model_sha256",
    "detections",
    "subject_identity_inference",
    "paths_disclosed"
  ],
  "properties": {
    "version": {"const": 1},
    "camera_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "detector_adapter": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "model_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "model_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "detections": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestamp_seconds",
          "label",
          "confidence",
          "bbox_xyxy"
        ],
        "properties": {
          "timestamp_seconds": {"type": "number", "minimum": 0},
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[^\\u0000\\r\\n]+$"
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "bbox_xyxy": {
            "type": "array",
            "prefixItems": [
              {"type": "number", "minimum": 0, "maximum": 1},
              {"type": "number", "minimum": 0, "maximum": 1},
              {"type": "number", "minimum": 0, "maximum": 1},
              {"type": "number", "minimum": 0, "maximum": 1}
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    },
    "subject_identity_inference": {"const": false},
    "paths_disclosed": {"const": false}
  }
}
