{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/daily-digest-export-receipt-v1.schema.json",
  "title": "Private Daily Digest Export Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "digest_id",
    "local_date",
    "plan_sha256",
    "video_sha256",
    "output_bytes",
    "output_duration_seconds",
    "selected_event_count",
    "selected_duration_seconds",
    "facts_only",
    "identity_inference",
    "risk_inference",
    "notification_decision",
    "external_delivery",
    "video_generated"
  ],
  "properties": {
    "version": { "const": 1 },
    "digest_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "local_date": { "type": "string", "format": "date" },
    "plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "video_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "output_bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
    "output_duration_seconds": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 600
    },
    "selected_event_count": { "type": "integer", "minimum": 1, "maximum": 60 },
    "selected_duration_seconds": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 600
    },
    "facts_only": { "const": true },
    "identity_inference": { "const": false },
    "risk_inference": { "const": false },
    "notification_decision": { "const": false },
    "external_delivery": { "const": false },
    "video_generated": { "const": true }
  }
}
