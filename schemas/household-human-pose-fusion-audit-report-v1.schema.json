{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roomsentry.example/schemas/household-human-pose-fusion-audit-report-v1.schema.json",
  "title": "HouseholdHumanPoseFusionAuditReport v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_sha256",
    "model_review_sha256",
    "temporal_holdout_attestation_sha256",
    "holdout_report_sha256",
    "profile_sha256",
    "media_admission_sha256s",
    "detector_scan_sha256s",
    "pose_scan_sha256s",
    "camera_ids",
    "bin_seconds",
    "model_agreement",
    "fusion_metrics",
    "version",
    "report_type",
    "label",
    "reference_provenance",
    "fusion_operator",
    "temporal_aggregation_strategy",
    "prediction_anchor",
    "hold_window_semantics",
    "temporal_holdout_attested",
    "profile_frozen_before_holdout_capture",
    "profile_selected_on_human_reference",
    "capture_order_operator_confirmed",
    "capture_order_cryptographically_proven",
    "human_review_completed",
    "human_verified",
    "human_reviewer_count",
    "single_human_reference",
    "labels_created_without_model_outputs",
    "blind_ui_operator_attested",
    "blindness_cryptographically_proven",
    "frame_sample_only",
    "model_generated_reference_labels",
    "ground_truth",
    "independent_human_ground_truth",
    "temporal_episode_ground_truth",
    "official_accuracy_claim",
    "diagnostic_only",
    "shadow_only",
    "winner_selected",
    "deployment_approved",
    "household_configuration_changed",
    "dataset_specific_only",
    "subject_identity_inference",
    "posture_classification",
    "risk_accuracy_evaluated",
    "source_media_included",
    "paths_disclosed",
    "report_sha256"
  ],
  "properties": {
    "audit_sha256": { "$ref": "#/$defs/sha256" },
    "model_review_sha256": { "$ref": "#/$defs/sha256" },
    "temporal_holdout_attestation_sha256": { "$ref": "#/$defs/sha256" },
    "holdout_report_sha256": { "$ref": "#/$defs/sha256" },
    "profile_sha256": { "$ref": "#/$defs/sha256" },
    "media_admission_sha256s": { "$ref": "#/$defs/sha256Array" },
    "detector_scan_sha256s": { "$ref": "#/$defs/sha256Array" },
    "pose_scan_sha256s": { "$ref": "#/$defs/sha256Array" },
    "camera_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeId" }
    },
    "bin_seconds": { "type": "number", "minimum": 0.1, "maximum": 60 },
    "model_agreement": { "$ref": "#/$defs/agreementMetrics" },
    "fusion_metrics": { "$ref": "#/$defs/fusionMetrics" },
    "version": { "const": 1 },
    "report_type": { "const": "single_human_blind_pose_fusion_audit" },
    "label": { "const": "person" },
    "reference_provenance": { "const": "single_human_blind_frame_review" },
    "fusion_operator": { "const": "detector_or_gated_pose" },
    "temporal_aggregation_strategy": { "const": "independent_causal_signal_holds" },
    "prediction_anchor": { "const": "bin_end" },
    "hold_window_semantics": { "const": "current_bin_plus_prior_seconds" },
    "temporal_holdout_attested": { "const": true },
    "profile_frozen_before_holdout_capture": { "const": true },
    "profile_selected_on_human_reference": { "const": false },
    "capture_order_operator_confirmed": { "const": true },
    "capture_order_cryptographically_proven": { "const": false },
    "human_review_completed": { "const": true },
    "human_verified": { "const": true },
    "human_reviewer_count": { "const": 1 },
    "single_human_reference": { "const": true },
    "labels_created_without_model_outputs": { "const": true },
    "blind_ui_operator_attested": { "const": true },
    "blindness_cryptographically_proven": { "const": false },
    "frame_sample_only": { "const": true },
    "model_generated_reference_labels": { "const": false },
    "ground_truth": { "const": false },
    "independent_human_ground_truth": { "const": false },
    "temporal_episode_ground_truth": { "const": false },
    "official_accuracy_claim": { "const": false },
    "diagnostic_only": { "const": true },
    "shadow_only": { "const": true },
    "winner_selected": { "const": false },
    "deployment_approved": { "const": false },
    "household_configuration_changed": { "const": false },
    "dataset_specific_only": { "const": true },
    "subject_identity_inference": { "const": false },
    "posture_classification": { "const": false },
    "risk_accuracy_evaluated": { "const": false },
    "source_media_included": { "const": false },
    "paths_disclosed": { "const": false },
    "report_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256Array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "count": { "type": "integer", "minimum": 0, "maximum": 10000000 },
    "ratio": {
      "oneOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "null" }
      ]
    },
    "agreementCameraPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera_id",
        "reviewed_frame_count",
        "human_present_frame_count",
        "human_absent_frame_count",
        "human_unknown_frame_count",
        "model_present_frame_count",
        "model_absent_frame_count",
        "model_unknown_frame_count",
        "comparable_frame_count",
        "agreement_count",
        "disagreement_count",
        "model_present_human_present",
        "model_present_human_absent",
        "model_present_human_unknown",
        "model_absent_human_present",
        "model_absent_human_absent",
        "model_absent_human_unknown",
        "model_unknown_human_present",
        "model_unknown_human_absent",
        "model_unknown_human_unknown",
        "agreement_rate"
      ],
      "properties": {
        "camera_id": { "$ref": "#/$defs/safeId" },
        "reviewed_frame_count": { "$ref": "#/$defs/count" },
        "human_present_frame_count": { "$ref": "#/$defs/count" },
        "human_absent_frame_count": { "$ref": "#/$defs/count" },
        "human_unknown_frame_count": { "$ref": "#/$defs/count" },
        "model_present_frame_count": { "$ref": "#/$defs/count" },
        "model_absent_frame_count": { "$ref": "#/$defs/count" },
        "model_unknown_frame_count": { "$ref": "#/$defs/count" },
        "comparable_frame_count": { "$ref": "#/$defs/count" },
        "agreement_count": { "$ref": "#/$defs/count" },
        "disagreement_count": { "$ref": "#/$defs/count" },
        "model_present_human_present": { "$ref": "#/$defs/count" },
        "model_present_human_absent": { "$ref": "#/$defs/count" },
        "model_present_human_unknown": { "$ref": "#/$defs/count" },
        "model_absent_human_present": { "$ref": "#/$defs/count" },
        "model_absent_human_absent": { "$ref": "#/$defs/count" },
        "model_absent_human_unknown": { "$ref": "#/$defs/count" },
        "model_unknown_human_present": { "$ref": "#/$defs/count" },
        "model_unknown_human_absent": { "$ref": "#/$defs/count" },
        "model_unknown_human_unknown": { "$ref": "#/$defs/count" },
        "agreement_rate": { "$ref": "#/$defs/ratio" }
      }
    },
    "agreementMetrics": {
      "allOf": [
        { "$ref": "#/$defs/agreementMetricFields" },
        {
          "type": "object",
          "required": ["camera_points"],
          "properties": {
            "camera_points": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": { "$ref": "#/$defs/agreementCameraPoint" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "agreementMetricFields": {
      "type": "object",
      "required": [
        "reviewed_frame_count",
        "human_present_frame_count",
        "human_absent_frame_count",
        "human_unknown_frame_count",
        "model_present_frame_count",
        "model_absent_frame_count",
        "model_unknown_frame_count",
        "comparable_frame_count",
        "agreement_count",
        "disagreement_count",
        "model_present_human_present",
        "model_present_human_absent",
        "model_present_human_unknown",
        "model_absent_human_present",
        "model_absent_human_absent",
        "model_absent_human_unknown",
        "model_unknown_human_present",
        "model_unknown_human_absent",
        "model_unknown_human_unknown",
        "agreement_rate"
      ],
      "properties": {
        "reviewed_frame_count": { "$ref": "#/$defs/count" },
        "human_present_frame_count": { "$ref": "#/$defs/count" },
        "human_absent_frame_count": { "$ref": "#/$defs/count" },
        "human_unknown_frame_count": { "$ref": "#/$defs/count" },
        "model_present_frame_count": { "$ref": "#/$defs/count" },
        "model_absent_frame_count": { "$ref": "#/$defs/count" },
        "model_unknown_frame_count": { "$ref": "#/$defs/count" },
        "comparable_frame_count": { "$ref": "#/$defs/count" },
        "agreement_count": { "$ref": "#/$defs/count" },
        "disagreement_count": { "$ref": "#/$defs/count" },
        "model_present_human_present": { "$ref": "#/$defs/count" },
        "model_present_human_absent": { "$ref": "#/$defs/count" },
        "model_present_human_unknown": { "$ref": "#/$defs/count" },
        "model_absent_human_present": { "$ref": "#/$defs/count" },
        "model_absent_human_absent": { "$ref": "#/$defs/count" },
        "model_absent_human_unknown": { "$ref": "#/$defs/count" },
        "model_unknown_human_present": { "$ref": "#/$defs/count" },
        "model_unknown_human_absent": { "$ref": "#/$defs/count" },
        "model_unknown_human_unknown": { "$ref": "#/$defs/count" },
        "agreement_rate": { "$ref": "#/$defs/ratio" }
      }
    },
    "fusionCameraPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera_id",
        "reviewed_bin_count",
        "evaluated_bin_count",
        "positive_bin_count",
        "negative_bin_count",
        "unknown_bin_count",
        "true_positive",
        "false_positive",
        "false_negative",
        "true_negative",
        "precision",
        "recall",
        "f1",
        "specificity",
        "false_positive_rate"
      ],
      "properties": {
        "camera_id": { "$ref": "#/$defs/safeId" },
        "reviewed_bin_count": { "$ref": "#/$defs/count" },
        "evaluated_bin_count": { "$ref": "#/$defs/count" },
        "positive_bin_count": { "$ref": "#/$defs/count" },
        "negative_bin_count": { "$ref": "#/$defs/count" },
        "unknown_bin_count": { "$ref": "#/$defs/count" },
        "true_positive": { "$ref": "#/$defs/count" },
        "false_positive": { "$ref": "#/$defs/count" },
        "false_negative": { "$ref": "#/$defs/count" },
        "true_negative": { "$ref": "#/$defs/count" },
        "precision": { "$ref": "#/$defs/ratio" },
        "recall": { "$ref": "#/$defs/ratio" },
        "f1": { "$ref": "#/$defs/ratio" },
        "specificity": { "$ref": "#/$defs/ratio" },
        "false_positive_rate": { "$ref": "#/$defs/ratio" }
      }
    },
    "fusionMetrics": {
      "allOf": [
        { "$ref": "#/$defs/fusionMetricFields" },
        {
          "type": "object",
          "required": ["camera_points"],
          "properties": {
            "camera_points": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": { "$ref": "#/$defs/fusionCameraPoint" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "fusionMetricFields": {
      "type": "object",
      "required": [
        "reviewed_bin_count",
        "evaluated_bin_count",
        "positive_bin_count",
        "negative_bin_count",
        "unknown_bin_count",
        "true_positive",
        "false_positive",
        "false_negative",
        "true_negative",
        "precision",
        "recall",
        "f1",
        "specificity",
        "false_positive_rate"
      ],
      "properties": {
        "reviewed_bin_count": { "$ref": "#/$defs/count" },
        "evaluated_bin_count": { "$ref": "#/$defs/count" },
        "positive_bin_count": { "$ref": "#/$defs/count" },
        "negative_bin_count": { "$ref": "#/$defs/count" },
        "unknown_bin_count": { "$ref": "#/$defs/count" },
        "true_positive": { "$ref": "#/$defs/count" },
        "false_positive": { "$ref": "#/$defs/count" },
        "false_negative": { "$ref": "#/$defs/count" },
        "true_negative": { "$ref": "#/$defs/count" },
        "precision": { "$ref": "#/$defs/ratio" },
        "recall": { "$ref": "#/$defs/ratio" },
        "f1": { "$ref": "#/$defs/ratio" },
        "specificity": { "$ref": "#/$defs/ratio" },
        "false_positive_rate": { "$ref": "#/$defs/ratio" }
      }
    }
  }
}
