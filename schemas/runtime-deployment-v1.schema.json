{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/baby-monitor/runtime-deployment-v1.schema.json",
  "title": "RuntimeDeploymentProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "deployment_id",
    "project_root",
    "config_path",
    "database_path",
    "output_root",
    "buffer_run_seconds",
    "confirm_ephemeral_buffer_eviction",
    "cameras"
  ],
  "properties": {
    "version": {"const": 1},
    "deployment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "project_root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "config_path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "database_path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "output_root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "buffer_run_seconds": {
      "type": "integer",
      "minimum": 300,
      "maximum": 86400
    },
    "confirm_ephemeral_buffer_eviction": {"type": "boolean"},
    "deferred_reports": {"type": "boolean", "default": false},
    "candidate_detector": {
      "type": "string",
      "enum": ["scene", "yolo_command"],
      "default": "scene"
    },
    "pose_presence_shadow": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "profile_path",
        "temporal_attestation_path",
        "human_audit_report_path",
        "detector_manifest_path",
        "detector_weights_path",
        "detector_runner_executable",
        "pose_manifest_path",
        "pose_weights_path",
        "pose_runner_executable"
      ],
      "properties": {
        "profile_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "temporal_attestation_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "human_audit_report_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "detector_manifest_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "detector_weights_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "detector_runner_executable": {"type": "string", "minLength": 1, "maxLength": 4096},
        "pose_manifest_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "pose_weights_path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "pose_runner_executable": {"type": "string", "minLength": 1, "maxLength": 4096},
        "detector_device": {
          "type": "string",
          "pattern": "^(cpu|[0-9]+)$",
          "default": "0"
        },
        "pose_device": {
          "type": "string",
          "pattern": "^(cpu|[0-9]+)$",
          "default": "0"
        },
        "pose_timeout_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 3600,
          "default": 600
        },
        "sample_interval_seconds": {
          "type": "number",
          "minimum": 30,
          "maximum": 3600,
          "default": 300
        }
      },
      "default": null
    },
    "trial_run_seconds": {
      "type": ["integer", "null"],
      "minimum": 3600,
      "maximum": 604800,
      "default": null
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["camera_id", "rtsp_uri", "buffer_root"],
        "properties": {
          "camera_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "rtsp_uri": {"type": "string", "minLength": 1, "maxLength": 2048},
          "buffer_root": {"type": "string", "minLength": 1, "maxLength": 4096},
          "image_size": {
            "type": "integer",
            "minimum": 320,
            "maximum": 1280,
            "multipleOf": 32,
            "default": 640
          },
          "rotation_degrees": {
            "type": "integer",
            "enum": [0, 90, 180, 270],
            "default": 0
          }
        }
      }
    }
  }
}
