{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/baby-monitor/archive-manifest-v1.schema.json",
  "title": "Baby monitor archive manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "archive_id", "created_at", "items"],
  "properties": {
    "version": { "const": 1 },
    "archive_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,80}$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "size_bytes", "sha256"],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,160}(?:/[A-Za-z0-9_.-]{1,160})*$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 68719476736
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
