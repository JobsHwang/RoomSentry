{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baby-monitor.local/schemas/visual-predicate-shadow-run-v1.schema.json",
  "title": "Visual Predicate Shadow Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "gate",
    "results",
    "recorded_at",
    "subject_identity_inference",
    "risk_inference",
    "notification_decision",
    "paths_disclosed",
    "media_metadata_included"
  ],
  "properties": {
    "version": { "const": 1 },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "event_id",
        "selected",
        "triggers",
        "predicates",
        "person_detector_id",
        "person_detection_count",
        "hardware_signal_adapters",
        "hardware_signal_count",
        "subject_identity_inference",
        "risk_inference",
        "notification_decision",
        "paths_disclosed"
      ],
      "properties": {
        "version": { "const": 1 },
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "selected": { "const": true },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["person_detection", "hardware_signal", "periodic_sample"]
          }
        },
        "predicates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "face_visibility",
              "support_contact_visible",
              "posture_transition_visible",
              "covering_near_face_visible"
            ]
          }
        },
        "person_detector_id": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" }
          ]
        },
        "person_detection_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "hardware_signal_adapters": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          }
        },
        "hardware_signal_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "subject_identity_inference": { "const": false },
        "risk_inference": { "const": false },
        "notification_decision": { "const": false },
        "paths_disclosed": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "triggers": { "contains": { "const": "person_detection" } }
            }
          },
          "then": {
            "properties": {
              "person_detector_id": { "type": "string" },
              "person_detection_count": { "minimum": 1 }
            }
          },
          "else": {
            "properties": {
              "person_detection_count": { "const": 0 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "triggers": { "contains": { "const": "hardware_signal" } }
            }
          },
          "then": {
            "properties": {
              "hardware_signal_adapters": { "minItems": 1 },
              "hardware_signal_count": { "minimum": 1 }
            }
          },
          "else": {
            "properties": {
              "hardware_signal_adapters": { "maxItems": 0 },
              "hardware_signal_count": { "const": 0 }
            }
          }
        }
      ]
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "visual-predicate-result-v1.schema.json"
      }
    },
    "recorded_at": { "type": "string", "format": "date-time" },
    "subject_identity_inference": { "const": false },
    "risk_inference": { "const": false },
    "notification_decision": { "const": false },
    "paths_disclosed": { "const": false },
    "media_metadata_included": { "const": false }
  },
  "$comment": "The canonical Python contract additionally binds gate/result event IDs, exact predicate order, evidence frame IDs, one model/revision/prompt tuple, all trigger counts, and SQLite idempotency/conflict behavior."
}
