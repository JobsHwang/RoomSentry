{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baby Monitor PoseFrameBatch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "camera_id",
    "pose_adapter",
    "model_id",
    "model_revision",
    "model_sha256",
    "frames",
    "subject_identity_inference",
    "posture_classification",
    "paths_disclosed"
  ],
  "properties": {
    "version": {"const": 1},
    "camera_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "pose_adapter": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "model_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "model_revision": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/frame"}
    },
    "subject_identity_inference": {"const": false},
    "posture_classification": {"const": false},
    "paths_disclosed": {"const": false}
  },
  "$defs": {
    "coordinate": {
      "oneOf": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "null"}
      ]
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "keypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "x", "y", "confidence", "in_frame"],
      "properties": {
        "name": {"type": "string", "enum": [
          "nose", "left_eye", "right_eye", "left_ear", "right_ear",
          "left_shoulder", "right_shoulder", "left_elbow", "right_elbow",
          "left_wrist", "right_wrist", "left_hip", "right_hip",
          "left_knee", "right_knee", "left_ankle", "right_ankle"
        ]},
        "x": {"$ref": "#/$defs/coordinate"},
        "y": {"$ref": "#/$defs/coordinate"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "in_frame": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"in_frame": {"const": true}}},
          "then": {
            "properties": {
              "x": {"type": "number", "minimum": 0, "maximum": 1},
              "y": {"type": "number", "minimum": 0, "maximum": 1}
            }
          },
          "else": {
            "properties": {"x": {"type": "null"}, "y": {"type": "null"}}
          }
        }
      ]
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "label", "confidence", "bbox_xyxy", "keypoints"],
      "properties": {
        "instance_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
        "label": {"const": "person"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "bbox_xyxy": {"$ref": "#/$defs/bbox"},
        "keypoints": {
          "type": "array",
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/keypoint"}, {"properties": {"name": {"const": "nose"}}}]},
            {"allOf": [{"$ref": "#/$defs/keypoint"}, {"properties": {"name": {"const": "left_eye"}}}]},
            {"allOf": [{"$ref": "#/$defs/keypoint"}, {"properties": {"name": {"const": "right_eye"}}}]},
            {"allOf": [{"$ref": "#/$defs/keypoint"}, {"properties": {"name": {"const": "left_ear"}}}]},
            {"allOf": [{"$ref": "#/$defs/keypoint"}, {"properties": {"name": {"const": "right_ear"}}}]},
            {"allOf": [{"$ref": "#/$defs/keypoint"}, {"properties": {"name": {"const": "left_shoulder"}}}]},
            {"allOf": [{"$ref": "#/$defs/keypoint"}, {"properties": {"name": {"const": "right_shoulder"}}}]},
            {"allOf": [{"$ref": "#/$defs/keypoint"}, {"properties": {"name": {"const": "left_elbow"}}}]},
            {"allOf": [{"$ref": "#/$defs/keypoint"}, {"properties": {"name": {"const": "right_elbow"}}}]},
            {"allOf": [{"$ref": "#/$defs/keypoint"}, {"properties": {"name": {"const": "left_wrist"}}}]},
            {"allOf": [{"$ref": "#/$defs/keypoint"}, {"properties": {"name": {"const": "right_wrist"}}}]},
            {"allOf": [{"$ref": "#/$defs/keypoint"}, {"properties": {"name": {"const": "left_hip"}}}]},
            {"allOf": [{"$ref": "#/$defs/keypoint"}, {"properties": {"name": {"const": "right_hip"}}}]},
            {"allOf": [{"$ref": "#/$defs/keypoint"}, {"properties": {"name": {"const": "left_knee"}}}]},
            {"allOf": [{"$ref": "#/$defs/keypoint"}, {"properties": {"name": {"const": "right_knee"}}}]},
            {"allOf": [{"$ref": "#/$defs/keypoint"}, {"properties": {"name": {"const": "left_ankle"}}}]},
            {"allOf": [{"$ref": "#/$defs/keypoint"}, {"properties": {"name": {"const": "right_ankle"}}}]}
          ],
          "items": false,
          "minItems": 17,
          "maxItems": 17
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "timestamp_seconds", "poses"],
      "properties": {
        "frame_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
        "timestamp_seconds": {"type": "number", "minimum": 0, "maximum": 31536000},
        "poses": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/pose"}
        }
      }
    }
  }
}
