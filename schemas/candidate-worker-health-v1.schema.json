{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baby Monitor CandidateWorkerHealth v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "camera_id",
    "scanner_identity",
    "detector_identity",
    "checked_at",
    "state",
    "worker_running",
    "scans_started",
    "scans_succeeded",
    "scans_failed",
    "segments_scanned",
    "detections",
    "emitted_events",
    "queue_full_events",
    "last_scan_started_at",
    "last_scan_completed_at",
    "last_scan_duration_seconds",
    "last_execution_lock_wait_seconds",
    "last_error_code",
    "paths_disclosed",
    "identity_inference",
    "risk_assessment",
    "notification_authority"
  ],
  "properties": {
    "version": {"const": 1},
    "camera_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
    "scanner_identity": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
    "detector_identity": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
    "checked_at": {"type": "string", "format": "date-time"},
    "state": {"enum": ["starting", "scanning", "idle", "failed", "stopped"]},
    "worker_running": {"type": "boolean"},
    "scans_started": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "scans_succeeded": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "scans_failed": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "segments_scanned": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "detections": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "emitted_events": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "queue_full_events": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "last_scan_started_at": {
      "oneOf": [
        {"type": "string", "format": "date-time"},
        {"type": "null"}
      ]
    },
    "last_scan_completed_at": {
      "oneOf": [
        {"type": "string", "format": "date-time"},
        {"type": "null"}
      ]
    },
    "last_scan_duration_seconds": {
      "oneOf": [
        {"type": "number", "minimum": 0, "maximum": 604800},
        {"type": "null"}
      ]
    },
    "last_execution_lock_wait_seconds": {
      "oneOf": [
        {"type": "number", "minimum": 0, "maximum": 3600},
        {"type": "null"}
      ]
    },
    "last_error_code": {
      "oneOf": [
        {"type": "string", "pattern": "^[a-z0-9_]{1,80}$"},
        {"type": "null"}
      ]
    },
    "paths_disclosed": {"const": false},
    "identity_inference": {"const": false},
    "risk_assessment": {"const": false},
    "notification_authority": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"enum": ["starting", "scanning", "idle"]}}},
      "then": {"properties": {"worker_running": {"const": true}}},
      "else": {"properties": {"worker_running": {"const": false}}}
    },
    {
      "if": {"properties": {"state": {"const": "failed"}}},
      "then": {"properties": {"last_error_code": {"type": "string"}}},
      "else": {"properties": {"last_error_code": {"type": "null"}}}
    }
  ],
  "$comment": "Cross-field counter and timestamp ordering constraints remain enforced by the canonical Python parser."
}
