{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/baby-monitor/household-episode-annotation-v1.schema.json",
  "title": "Baby Monitor HouseholdEpisodeAnnotation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "annotation_id",
    "media_admission_sha256",
    "camera_id",
    "source_fps",
    "source_frame_count",
    "source_duration_seconds",
    "scenario_tags",
    "ranges",
    "review_state",
    "reviewers",
    "human_verified",
    "model_generated_labels",
    "source_media_included",
    "paths_disclosed",
    "subject_identity_inference",
    "annotation_sha256"
  ],
  "properties": {
    "version": {"const": 1},
    "annotation_id": {"$ref": "#/$defs/id"},
    "media_admission_sha256": {"$ref": "#/$defs/sha256"},
    "camera_id": {"$ref": "#/$defs/id"},
    "source_fps": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 240
    },
    "source_frame_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "source_duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 86400
    },
    "scenario_tags": {
      "type": "array",
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"enum": [
        "crib_overhead_view",
        "daytime",
        "eye_level_view",
        "large_subject_scale",
        "night_vision",
        "partial_occlusion",
        "small_subject_scale"
      ]}
    },
    "ranges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/range"}
    },
    "review_state": {"enum": ["pending", "approved"]},
    "reviewers": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reviewer"}
    },
    "human_verified": {"type": "boolean"},
    "model_generated_labels": {"const": false},
    "source_media_included": {"const": false},
    "paths_disclosed": {"const": false},
    "subject_identity_inference": {"const": false},
    "annotation_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer": {
      "type": "string",
      "pattern": "^reviewer_[A-Za-z0-9_.-]{1,64}$"
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_seconds", "end_seconds", "kind"],
      "properties": {
        "start_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "end_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "kind": {"enum": ["danger_event", "empty_room", "person_present"]}
      }
    }
  }
}
