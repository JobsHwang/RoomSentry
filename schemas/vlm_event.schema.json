{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/vlm_event.schema.json",
  "title": "Baby monitor VLM event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "subjects",
    "observations",
    "inferences",
    "risk_level",
    "confidence",
    "needs_remote_review",
    "summary_zh",
    "evidence_frames"
  ],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": ["sleeping", "awake", "crying", "movement", "adult_interaction", "possible_risk", "unknown"]
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "confidence", "evidence_frames"],
        "properties": {
          "kind": {"type": "string", "enum": ["baby", "adult", "person", "pet", "unknown"]},
          "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
          "evidence_frames": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "observations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "inferences": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risk_level": {"type": "string", "enum": ["none", "low", "medium", "high"]},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "needs_remote_review": {"type": "boolean"},
    "summary_zh": {"type": "string"},
    "evidence_frames": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}

