{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baby Monitor SignalEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "signal_id",
    "camera_id",
    "occurred_at",
    "signal_type",
    "source_adapter",
    "confidence",
    "attributes"
  ],
  "properties": {
    "version": {"const": 1},
    "signal_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
    "camera_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "signal_type": {
      "enum": [
        "motion",
        "person",
        "face",
        "sound_peak",
        "hardware_cry",
        "zone_enter",
        "zone_dwell",
        "zone_exit",
        "fall_hint",
        "manual_trigger"
      ]
    },
    "source_adapter": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
        "direction": {"enum": ["enter", "exit", "unknown"]},
        "duration_ms": {"type": "integer", "minimum": 0, "maximum": 86400000},
        "object_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "severity_hint": {"enum": ["none", "low", "medium", "high"]},
        "tracking_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
        "zone_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"}
      }
    }
  }
}
