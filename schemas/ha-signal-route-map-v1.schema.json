{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baby-monitor.local/schemas/ha-signal-route-map-v1.schema.json",
  "title": "Home Assistant signal to local buffer route map v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "routes"],
  "properties": {
    "version": {
      "const": 1
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["camera_id", "manifest_path"],
        "properties": {
          "camera_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "manifest_path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
