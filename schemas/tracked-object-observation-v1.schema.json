{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baby Monitor TrackedObjectObservation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "observation_id",
    "camera_id",
    "occurred_at",
    "source_adapter",
    "tracking_id",
    "label",
    "confidence",
    "bbox_xyxy"
  ],
  "properties": {
    "version": {"const": 1},
    "observation_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
    "camera_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "source_adapter": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
    "tracking_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "bbox_xyxy": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0.0, "maximum": 1.0},
        {"type": "number", "minimum": 0.0, "maximum": 1.0},
        {"type": "number", "minimum": 0.0, "maximum": 1.0},
        {"type": "number", "minimum": 0.0, "maximum": 1.0}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    }
  }
}
