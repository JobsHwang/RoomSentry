{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baby Monitor TemporalZoneConfig v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "track_expiry_seconds", "max_processed_observations", "zones"],
  "properties": {
    "version": {"const": 1},
    "track_expiry_seconds": {"type": "number", "minimum": 1.0, "maximum": 86400.0},
    "max_processed_observations": {"type": "integer", "minimum": 1, "maximum": 10000},
    "zones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["zone_id", "labels", "bbox_xyxy", "dwell_seconds", "exit_margin"],
        "properties": {
          "zone_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
          "labels": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[^\\u0000\\r\\n]+$"
            }
          },
          "bbox_xyxy": {
            "type": "array",
            "prefixItems": [
              {"type": "number", "minimum": 0.0, "maximum": 1.0},
              {"type": "number", "minimum": 0.0, "maximum": 1.0},
              {"type": "number", "minimum": 0.0, "maximum": 1.0},
              {"type": "number", "minimum": 0.0, "maximum": 1.0}
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4
          },
          "dwell_seconds": {"type": "number", "minimum": 0.1, "maximum": 86400.0},
          "exit_margin": {"type": "number", "minimum": 0.0, "maximum": 0.25},
          "minimum_confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
        }
      }
    }
  }
}
